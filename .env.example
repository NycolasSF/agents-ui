# ANTHROPIC_API_KEY não é mais necessário.
# A interface usa o claude CLI autenticado pelo Claude Code (plano Max/Pro).
# Certifique-se de estar autenticado: rode `claude` uma vez no terminal para confirmar.

# Caminho para a pasta skills (relativo à raiz do repo)
# Não precisa alterar se rodar de dentro de agents-ui/
SKILLS_PATH=../skills

# Porta do servidor backend (padrão: 3002)
# PORT=3002
